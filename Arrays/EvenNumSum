
using System;

class EvenNumSum
{
    static void Main()
    {
        int[] arr = new int[5];
        int count = 0;

        Console.WriteLine("EVEN NUMBER COUNTER");
        Console.WriteLine("-------------------");

        for (int i = 0; i < arr.Length; i++)
        {
            Console.Write($"Enter number {i + 1}: ");
            arr[i] = Convert.ToInt32(Console.ReadLine());
        }

        for (int i = 0; i < arr.Length; i++)
        {
            if (arr[i] % 2 == 0)
            {
                count++;
            }
        }

        Console.WriteLine($"\nTotal even numbers in the array: {count}");
    }
}
